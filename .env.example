# 切片 004 本地运行配置。真实初始密码和签名密钥只通过环境变量提供。
DATABASE_URL=postgresql://interaction_pattern_lab:local_development_only@127.0.0.1:55432/interaction_pattern_lab?schema=public
SYSTEM_CODES=demo-portal,secondary-demo
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SESSION_SIGNING_KEY=replace-with-at-least-32-random-characters
PREVIOUS_SESSION_SIGNING_KEY=
INITIAL_ADMIN_PASSWORD=replace-with-at-least-12-characters
INITIAL_VIEWER_PASSWORD=replace-with-at-least-12-characters
PORT=3000
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
ATTACHMENT_STORAGE_ROOT=./var/attachments
ATTACHMENT_MAX_BYTES=20971520

# Digital employee connector credentials (server only). Use a random 32-byte base64 value.
DIGITAL_EMPLOYEE_ENCRYPTION_KEY=

# AI analysis (backend only). Never use a VITE_ prefix for these variables.
AI_PROVIDER=anthropic
AI_BASE_URL=https://token.cvte.com
AI_MODEL=CVTE-AUTO
AGENT_AI_MODEL=deepseek-flash
AI_AUTH_TOKEN=
AI_TIMEOUT_MS=120000
AI_MAX_INPUT_CHARS=100000
AI_DAILY_LIMIT=30

# Internal Flowable adapter (server only; copy token from infra/workflow/.env locally)
WORKFLOW_ENGINE_URL=http://127.0.0.1:8091
WORKFLOW_SERVICE_TOKEN=
