{
  "name": "interaction-pattern-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint src vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "build": "pnpm typecheck && vite build",
    "generate:patterns": "node scripts/generate-pattern-projection.mjs",
    "validate:patterns": "node scripts/validate-pattern-projection.mjs",
    "validate:scenarios": "node scripts/validate-scenario-contracts.mjs",
    "validate:isolation": "node scripts/validate-demo-isolation.mjs",
    "validate:ui-assets": "node scripts/validate-ui-asset-boundaries.mjs",
    "verify": "pnpm validate:patterns && pnpm validate:scenarios && pnpm validate:isolation && pnpm validate:ui-assets && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.0.1",
    "globals": "17.11.0",
    "jsdom": "26.1.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.68.0",
    "vite": "5.4.20",
    "vitest": "3.2.4"
  }
}
