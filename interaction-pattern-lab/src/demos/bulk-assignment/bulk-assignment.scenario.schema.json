{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdd-forge://interaction-pattern-lab/VAL-002/scenario.schema.json",
  "type": "object",
  "required": ["version", "validationId", "failureCodes", "keyboardPath", "scenarios"],
  "properties": {
    "version": { "const": 1 },
    "validationId": { "const": "VAL-002" },
    "failureCodes": { "type": "array", "minItems": 4, "items": { "type": "string" } },
    "keyboardPath": { "type": "array", "minItems": 4, "items": { "type": "string" } },
    "scenarios": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "label", "initialQuery", "actions", "expectedOutcome"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "initialQuery": { "type": "string" },
          "actions": { "type": "array", "items": { "type": "string" } },
          "expectedOutcome": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
