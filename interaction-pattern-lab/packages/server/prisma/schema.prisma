generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  DISABLED
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum MenuNodeType {
  GROUP
  PAGE
}

enum RoleType {
  SYSTEM
  BUSINESS
}

enum PermissionType {
  MENU
  ACTION
}

model UiMenu {
  id         String       @id @default(uuid()) @db.Uuid
  systemCode String       @map("system_code") @db.VarChar(64)
  menuCode   String       @map("menu_code") @db.VarChar(64)
  menuName   String       @map("menu_name") @db.VarChar(128)
  nodeType   MenuNodeType @map("node_type")
  parentId   String?      @map("parent_id") @db.Uuid
  routePath  String?      @map("route_path") @db.VarChar(256)
  iconKey    String       @map("icon_key") @db.VarChar(64)
  sortNo     Int          @default(0) @map("sort_no")
  status     RecordStatus @default(ACTIVE)
  version    Int          @default(1)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  parent     UiMenu?      @relation("MenuTree", fields: [parentId, systemCode], references: [id, systemCode], onDelete: Restrict, onUpdate: Cascade)
  children   UiMenu[]     @relation("MenuTree")
  actions    UiMenuAction[]
  grants     IamRolePermission[]

  @@unique([systemCode, menuCode], map: "ui_menu_system_code_menu_code_key")
  @@unique([id, systemCode], map: "ui_menu_id_system_code_key")
  @@index([systemCode, status, parentId, sortNo], map: "ui_menu_navigation_idx")
  @@map("ui_menu")
}

model UiMenuAction {
  id         String       @id @default(uuid()) @db.Uuid
  menuId     String       @map("menu_id") @db.Uuid
  actionCode String       @map("action_code") @db.VarChar(64)
  actionName String       @map("action_name") @db.VarChar(128)
  actionType String       @map("action_type") @db.VarChar(64)
  sortNo     Int          @default(0) @map("sort_no")
  status     RecordStatus @default(ACTIVE)
  version    Int          @default(1)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  menu       UiMenu       @relation(fields: [menuId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grants     IamRolePermission[]

  @@unique([menuId, actionCode], map: "ui_menu_action_menu_id_action_code_key")
  @@unique([id, menuId], map: "ui_menu_action_id_menu_id_key")
  @@index([menuId, status, sortNo], map: "ui_menu_action_lookup_idx")
  @@map("ui_menu_action")
}

model IamUser {
  id                String       @id @default(uuid()) @db.Uuid
  account           String       @db.VarChar(128)
  normalizedAccount String       @unique(map: "iam_user_normalized_account_key") @map("normalized_account") @db.VarChar(128)
  displayName       String       @map("display_name") @db.VarChar(128)
  authSource        String       @default("LOCAL") @map("auth_source") @db.VarChar(32)
  externalSubject   String?      @map("external_subject") @db.VarChar(256)
  passwordHash      String?      @map("password_hash") @db.VarChar(512)
  status            UserStatus   @default(ACTIVE)
  version           Int          @default(1)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  roleMemberships   IamRoleUser[]
  personalListViews UiUserListView[]
  listViewPreferences UiUserListViewPreference[]

  @@index([status], map: "iam_user_status_idx")
  @@map("iam_user")
}

model IamRole {
  id          String       @id @default(uuid()) @db.Uuid
  systemCode  String       @map("system_code") @db.VarChar(64)
  roleCode    String       @map("role_code") @db.VarChar(64)
  roleName    String       @map("role_name") @db.VarChar(128)
  roleType    RoleType     @map("role_type")
  isSystem    Boolean      @default(false) @map("is_system")
  description String?      @db.VarChar(512)
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  members     IamRoleUser[]
  grants      IamRolePermission[]
  listViews   IamRoleListView[]

  @@unique([systemCode, roleCode], map: "iam_role_system_code_role_code_key")
  @@unique([id, systemCode], map: "iam_role_id_system_code_key")
  @@index([systemCode, status], map: "iam_role_lookup_idx")
  @@map("iam_role")
}

model IamRoleUser {
  roleId      String       @map("role_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  status      RecordStatus @default(ACTIVE)
  effectiveAt DateTime?    @map("effective_at") @db.Timestamptz(3)
  expiresAt   DateTime?    @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  role        IamRole      @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user        IamUser      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([roleId, userId])
  @@index([userId, status, effectiveAt, expiresAt], map: "iam_role_user_effective_idx")
  @@map("iam_role_user")
}

model IamRolePermission {
  id             String         @id @default(uuid()) @db.Uuid
  systemCode     String         @map("system_code") @db.VarChar(64)
  roleId         String         @map("role_id") @db.Uuid
  menuId         String         @map("menu_id") @db.Uuid
  permissionType PermissionType @map("permission_type")
  menuActionId   String?        @map("menu_action_id") @db.Uuid
  status         RecordStatus   @default(ACTIVE)
  version        Int            @default(1)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  role           IamRole        @relation(fields: [roleId, systemCode], references: [id, systemCode], onDelete: Restrict, onUpdate: Cascade)
  menu           UiMenu         @relation(fields: [menuId, systemCode], references: [id, systemCode], onDelete: Restrict, onUpdate: Cascade)
  action         UiMenuAction?  @relation(fields: [menuActionId, menuId], references: [id, menuId], onDelete: Restrict, onUpdate: Cascade)

  @@index([roleId, systemCode, status], map: "iam_role_permission_role_idx")
  @@index([menuId, menuActionId], map: "iam_role_permission_target_idx")
  @@map("iam_role_permission")
}

model SysDictionary {
  id          String       @id @default(uuid()) @db.Uuid
  systemCode  String       @map("system_code") @db.VarChar(64)
  dictCode    String       @map("dict_code") @db.VarChar(64)
  dictName    String       @map("dict_name") @db.VarChar(128)
  groupCode   String?      @map("group_code") @db.VarChar(64)
  parentId    String?      @map("parent_id") @db.Uuid
  description String?      @db.VarChar(512)
  sortNo      Int          @default(0) @map("sort_no")
  status      RecordStatus @default(ACTIVE)
  itemsEditable Boolean    @default(true) @map("items_editable")
  version     Int          @default(1)
  createdBy   String       @map("created_by") @db.VarChar(128)
  updatedBy   String       @map("updated_by") @db.VarChar(128)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  parent      SysDictionary? @relation("DictionaryTree", fields: [parentId, systemCode], references: [id, systemCode], onDelete: Restrict, onUpdate: Cascade)
  children    SysDictionary[] @relation("DictionaryTree")
  items       SysDictionaryItem[]

  @@unique([systemCode, dictCode], map: "sys_dictionary_system_code_dict_code_key")
  @@unique([id, systemCode], map: "sys_dictionary_id_system_code_key")
  @@index([systemCode, parentId, status, sortNo], map: "sys_dictionary_tree_idx")
  @@index([systemCode, status, sortNo], map: "sys_dictionary_lookup_idx")
  @@map("sys_dictionary")
}

model SysDictionaryItem {
  id          String       @id @default(uuid()) @db.Uuid
  dictionaryId String      @map("dictionary_id") @db.Uuid
  itemCode    String       @map("item_code") @db.VarChar(64)
  itemValue   String       @map("item_value") @db.VarChar(128)
  itemName    String       @map("item_name") @db.VarChar(128)
  colorKey    String?      @map("color_key") @db.VarChar(32)
  description String?      @db.VarChar(512)
  sortNo      Int          @default(0) @map("sort_no")
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)
  createdBy   String       @map("created_by") @db.VarChar(128)
  updatedBy   String       @map("updated_by") @db.VarChar(128)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  dictionary  SysDictionary @relation(fields: [dictionaryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([dictionaryId, itemCode], map: "sys_dictionary_item_dict_code_key")
  @@unique([dictionaryId, itemValue], map: "sys_dictionary_item_dict_value_key")
  @@index([dictionaryId, status, sortNo], map: "sys_dictionary_item_lookup_idx")
  @@map("sys_dictionary_item")
}

model UiSystemListView {
  id                    String       @id @default(uuid()) @db.Uuid
  systemCode            String       @map("system_code") @db.VarChar(64)
  pageCode              String       @map("page_code") @db.VarChar(64)
  actionCode            String       @map("action_code") @db.VarChar(64)
  viewCode              String       @map("view_code") @db.VarChar(64)
  viewName              String       @map("view_name") @db.VarChar(128)
  description           String?      @db.VarChar(512)
  isDefault             Boolean      @default(false) @map("is_default")
  allowPersonalOverride Boolean      @default(true) @map("allow_personal_override")
  priority              Int          @default(100)
  status                RecordStatus @default(ACTIVE)
  config                Json
  version               Int          @default(1)
  createdBy             String       @map("created_by") @db.VarChar(128)
  updatedBy             String       @map("updated_by") @db.VarChar(128)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  roleAssignments       IamRoleListView[]
  personalViews         UiUserListView[]

  @@unique([systemCode, pageCode, actionCode, viewCode], map: "ui_system_list_view_scope_code_key")
  @@index([systemCode, pageCode, actionCode, status, priority], map: "ui_system_list_view_lookup_idx")
  @@map("ui_system_list_view")
}

model IamRoleListView {
  roleId     String           @map("role_id") @db.Uuid
  viewId     String           @map("view_id") @db.Uuid
  status     RecordStatus     @default(ACTIVE)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  role       IamRole          @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  view       UiSystemListView @relation(fields: [viewId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([roleId, viewId])
  @@index([viewId, status], map: "iam_role_list_view_lookup_idx")
  @@map("iam_role_list_view")
}

model UiUserListView {
  id          String           @id @default(uuid()) @db.Uuid
  systemCode  String           @map("system_code") @db.VarChar(64)
  pageCode    String           @map("page_code") @db.VarChar(64)
  actionCode  String           @map("action_code") @db.VarChar(64)
  baseViewId  String           @map("base_view_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  viewName    String           @map("view_name") @db.VarChar(128)
  isDefault   Boolean          @default(false) @map("is_default")
  config      Json
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  baseView    UiSystemListView @relation(fields: [baseViewId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user        IamUser          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, systemCode, pageCode, actionCode, viewName], map: "ui_user_list_view_owner_scope_name_key")
  @@index([userId, systemCode, pageCode, actionCode], map: "ui_user_list_view_lookup_idx")
  @@map("ui_user_list_view")
}

model UiUserListViewPreference {
  userId          String   @map("user_id") @db.Uuid
  systemCode      String   @map("system_code") @db.VarChar(64)
  pageCode        String   @map("page_code") @db.VarChar(64)
  actionCode      String   @map("action_code") @db.VarChar(64)
  selectedViewKey String   @map("selected_view_key") @db.VarChar(160)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            IamUser  @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([userId, systemCode, pageCode, actionCode])
  @@map("ui_user_list_view_preference")
}

model CrmCustomer {
  id             String   @id @default(uuid()) @db.Uuid
  systemCode     String   @map("system_code") @db.VarChar(64)
  customerCode   String   @map("customer_code") @db.VarChar(20)
  customerName   String   @map("customer_name") @db.VarChar(255)
  shortName      String   @map("short_name") @db.VarChar(100)
  categoryValue  String   @map("category_value") @db.VarChar(128)
  address        String?  @db.VarChar(500)
  statusValue    String   @map("status_value") @db.VarChar(128)
  industryValue  String?  @map("industry_value") @db.VarChar(128)
  levelValue     String?  @map("level_value") @db.VarChar(128)
  salesOwnerKey  String?  @map("sales_owner_key") @db.VarChar(128)
  salesOwnerName String?  @map("sales_owner_name") @db.VarChar(128)
  remark         String?  @db.VarChar(1000)
  version        Int      @default(1)
  createdBy      String   @map("created_by") @db.VarChar(128)
  updatedBy      String   @map("updated_by") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([systemCode, customerCode], map: "crm_customer_system_code_customer_code_key")
  @@unique([systemCode, customerName], map: "crm_customer_system_code_customer_name_key")
  @@index([systemCode, statusValue, categoryValue, updatedAt(sort: Desc)], map: "crm_customer_list_idx")
  @@map("crm_customer")
}
