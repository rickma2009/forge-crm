{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdd-forge://enterprise-interaction-assets/index.schema.json",
  "title": "企业交互分类资产登记册",
  "type": "object",
  "required": ["version", "taxonomyRef", "generatedBy", "assets"],
  "properties": {
    "version": { "const": 1 },
    "taxonomyRef": { "type": "string", "minLength": 1 },
    "generatedBy": { "type": "string", "minLength": 1 },
    "assets": {
      "type": "array",
      "minItems": 103,
      "maxItems": 103,
      "items": {
        "type": "object",
        "required": ["assetId", "kind", "group", "name", "maturity", "definition", "definitionRef", "artifacts", "evidence", "evidenceCards", "nextEvidence"],
        "properties": {
          "assetId": { "type": "string", "pattern": "^EPM-(PAGE|ACT|VIEW|STATE|SPECIAL|SCENE)-[0-9]{3}$" },
          "kind": { "enum": ["PAGE", "ACT", "VIEW", "STATE", "SPECIAL", "SCENE"] },
          "group": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "maturity": { "enum": ["idea", "candidate", "implementation-verified", "interaction-verified", "project-adopted", "business-validated", "released", "deprecated"] },
          "definition": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "definitionRef": {
            "type": "object",
            "required": ["path", "section"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "section": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "artifacts": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "evidenceCards": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["evidenceId", "state", "archivedSourceRefs", "implementationRefs", "artifactRefs", "validation"],
              "properties": {
                "evidenceId": { "type": "string", "pattern": "^EVID-[A-Z0-9-]+$" },
                "state": { "enum": ["in-lab-candidate"] },
                "archivedSourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "implementationRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "artifactRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "validation": {
                  "type": "object",
                  "required": ["project", "slice", "environment", "versionPoint", "result", "unknowns"],
                  "properties": {
                    "project": { "type": "string", "minLength": 1 },
                    "slice": { "type": "string", "minLength": 1 },
                    "environment": { "type": "string", "minLength": 1 },
                    "versionPoint": { "type": "string", "minLength": 1 },
                    "result": { "type": "string", "minLength": 1 },
                    "unknowns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "nextEvidence": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
