{
  "name": "forge-crm",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=22.12.0", "pnpm": ">=9.15.0" },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @forge-crm/web dev",
    "dev:server": "pnpm --filter @forge-crm/server dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "prisma:generate": "pnpm --filter @forge-crm/server prisma:generate",
    "db:migrate": "pnpm --filter @forge-crm/server db:migrate:deploy",
    "db:seed": "pnpm --filter @forge-crm/server db:seed",
    "validate:identity": "node --test scripts/project-identity.test.mjs scripts/start.test.mjs",
    "generate:patterns": "node scripts/generate-pattern-projection.mjs",
    "validate:patterns": "node scripts/validate-pattern-projection.mjs",
    "validate:showcase": "node scripts/validate-showcase-registry.mjs",
    "validate:scenarios": "node scripts/validate-scenario-contracts.mjs",
    "validate:isolation": "node scripts/validate-demo-isolation.mjs",
    "validate:data-grids": "node scripts/validate-shared-data-grids.mjs",
    "validate:ui-assets": "node scripts/validate-ui-asset-boundaries.mjs",
    "validate": "pnpm validate:identity && pnpm validate:patterns && pnpm validate:showcase && pnpm validate:scenarios && pnpm validate:isolation && pnpm validate:ui-assets && pnpm validate:data-grids",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck --concurrency=1",
    "test": "turbo test --concurrency=1",
    "build": "turbo build --concurrency=1",
    "verify": "pnpm validate && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.0.1",
    "globals": "17.11.0",
    "turbo": "^2.10.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.68.0"
  }
}
