  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  template    SdOppTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([templateId, stageCode], map: "sd_opp_stage_template_code_key")
  @@index([templateId, status, sortNo], map: "sd_opp_stage_lookup_idx")
  @@map("sd_opp_stage")
}

model SdOpp {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  applicationId      String       @map("application_id") @db.Uuid
  systemCode         String       @map("system_code") @db.VarChar(64)
  opportunityCode    String       @map("opportunity_code") @db.VarChar(32)
  opportunityName    String       @map("opportunity_name") @db.VarChar(200)
  customerId         String       @map("customer_id") @db.Uuid
  customerName       String       @map("customer_name") @db.VarChar(255)
  contactId          String?      @map("contact_id") @db.Uuid
  contactName        String?      @map("contact_name") @db.VarChar(100)
  ownerUserId        String       @map("owner_user_id") @db.Uuid
  ownerName          String       @map("owner_name") @db.VarChar(128)
  source             String?      @db.VarChar(128)
  templateId         String       @map("template_id") @db.Uuid
  templateName       String       @map("template_name") @db.VarChar(128)
  stageId            String       @map("stage_id") @db.Uuid
  stageName          String       @map("stage_name") @db.VarChar(128)
  stageProbability   Int          @map("stage_probability")
  confidence         Int          @default(0)
  confirmedDate      DateTime?    @map("confirmed_date") @db.Date
  expectedSignDate   DateTime?    @map("expected_sign_date") @db.Date
  customerBudget     Decimal?     @map("customer_budget") @db.Decimal(18, 2)
  expectedAmount     Decimal?     @map("expected_amount") @db.Decimal(18, 2)
  partner            String?      @db.VarChar(200)
  status             RecordStatus @default(ACTIVE)
  remark             String?      @db.VarChar(1000)
  version            Int          @default(1)
  createdBy          String       @map("created_by") @db.VarChar(128)
  updatedBy          String       @map("updated_by") @db.VarChar(128)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  products           SdOppProduct[]
  followUps          SdOppFollowUp[]
  analyses           SdOppAnalysis[]

  @@unique([applicationId, opportunityCode], map: "sd_opp_app_code_key")
  @@index([applicationId, status, updatedAt(sort: Desc)], map: "sd_opp_list_idx")
  @@index([customerId], map: "sd_opp_customer_idx")
  @@index([ownerUserId], map: "sd_opp_owner_idx")
  @@map("sd_opp")
}

model SdOppProduct {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  opportunityId  String   @map("opportunity_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  productCode    String   @map("item_code") @db.VarChar(32)
  productName    String   @map("product_name") @db.VarChar(128)
  model          String?  @db.VarChar(128)
  quantity       Decimal  @db.Decimal(18, 4)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 2)
  expectedAmount Decimal  @map("expected_amount") @db.Decimal(18, 2)
  requirement    String?  @db.VarChar(1000)
  sortNo         Int      @default(0) @map("sort_no")
  version        Int      @default(1)
  createdBy      String   @map("created_by") @db.VarChar(128)
  updatedBy      String   @map("updated_by") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  opportunity    SdOpp    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, sortNo], map: "sd_opp_product_list_idx")
  @@index([tenantId, productCode], map: "sd_opp_product_item_idx")
  @@map("sd_opp_product")
}

model SdOppFollowUp {
  id             String       @id @default(uuid()) @db.Uuid
  opportunityId  String       @map("opportunity_id") @db.Uuid
  followedAt     DateTime     @map("followed_at") @db.Timestamptz(3)
  followerUserId String       @map("follower_user_id") @db.Uuid
  followerName   String       @map("follower_name") @db.VarChar(128)
  workItem       String       @map("work_item") @db.VarChar(1000)
  resultNext     String?      @map("result_next") @db.VarChar(2000)
  status         RecordStatus @default(ACTIVE)
  version        Int          @default(1)
  createdBy      String       @map("created_by") @db.VarChar(128)
  updatedBy      String       @map("updated_by") @db.VarChar(128)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  opportunity    SdOpp        @relation(fields: [opportunityId], references: [id], onDelete: Restrict)

  @@index([opportunityId, followedAt(sort: Desc)], map: "sd_opp_follow_up_list_idx")
  @@map("sd_opp_follow_up")
}

model SdOppAnalysis {
  id               String                    @id @default(uuid()) @db.Uuid
  opportunityId    String                    @map("opportunity_id") @db.Uuid
  opportunityName  String                    @map("opportunity_name") @db.VarChar(200)
  stageId          String                    @map("stage_id") @db.Uuid
  stageName        String                    @map("stage_name") @db.VarChar(128)
  stageProbability Int                       @map("stage_probability")
  confidence       Int
  opportunityPoint String                    @map("opportunity_point") @db.VarChar(2000)
  risk             String                    @db.VarChar(2000)
  nextPlan         String                    @map("next_plan") @db.VarChar(2000)
  remark           String?                   @db.VarChar(1000)
  analystUserId    String                    @map("analyst_user_id") @db.Uuid
  analystName      String                    @map("analyst_name") @db.VarChar(128)
  analyzedAt       DateTime                  @default(now()) @map("analyzed_at") @db.Timestamptz(3)
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  opportunity      SdOpp                     @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  competitors      SdOppAnalysisCompetitor[]

  @@index([opportunityId, analyzedAt(sort: Desc)], map: "sd_opp_analysis_list_idx")
  @@map("sd_opp_analysis")
}

model SdOppAnalysisCompetitor {
  id             String        @id @default(uuid()) @db.Uuid
  analysisId     String        @map("analysis_id") @db.Uuid
  competitorId   String        @map("competitor_id") @db.Uuid
  competitorName String        @map("competitor_name") @db.VarChar(128)
  rank           Int
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  analysis       SdOppAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@unique([analysisId, rank], map: "sd_opp_analysis_rank_key")
  @@unique([analysisId, competitorId], map: "sd_opp_analysis_comp_key")
  @@map("sd_opp_analysis_competitor")
}

enum SceneStatus {
  DONE
  WIP
  TODO
}

model StyleScene {
  id          String      @id @default(uuid()) @db.Uuid
  systemCode  String      @map("system_code") @db.VarChar(64)
  category    String      @db.VarChar(64)
  subCategory String?     @map("sub_category") @db.VarChar(64)
  sceneName   String      @map("scene_name") @db.VarChar(128)
  description String?     @db.VarChar(512)
  status      SceneStatus @default(TODO)
  pagePath    String?     @map("page_path") @db.VarChar(256)
  note        String?     @db.VarChar(512)
  doneAt      DateTime?   @map("done_at") @db.Timestamptz(3)
  sortNo      Int         @default(0) @map("sort_no")
  version     Int         @default(1)
  createdBy   String      @map("created_by") @db.VarChar(128)
  updatedBy   String      @map("updated_by") @db.VarChar(128)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([systemCode, status, category, sortNo], map: "style_scene_list_idx")
  @@map("style_scene")
}

model SysParameter {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  applicationId  String         @map("application_id") @db.Uuid
  parameterCode  String         @map("parameter_code") @db.VarChar(64)
  parameterName  String         @map("parameter_name") @db.VarChar(128)
  value          String?        @map("parameter_value") @db.VarChar(1000)
  usageNote      String         @map("usage_note") @db.VarChar(1000)
  sortNo         Int            @default(0) @map("sort_no")
  status         RecordStatus   @default(ACTIVE)
  version        Int            @default(1)
  createdBy      String         @map("created_by") @db.VarChar(128)
  updatedBy      String         @map("updated_by") @db.VarChar(128)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  application    SysApplication @relation(fields: [applicationId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "sys_parameter_app_scope_fk")

  @@unique([tenantId, applicationId, parameterCode], map: "sys_parameter_scope_code_key")
  @@index([tenantId, applicationId, sortNo, parameterCode], map: "sys_parameter_list_idx")
  @@map("sys_parameter")
}
