  systemCode   String      @map("system_code") @db.VarChar(64)
  customerId   String      @map("customer_id") @db.Uuid
  name         String      @db.VarChar(100)
  department   String?     @db.VarChar(128)
  position     String?     @db.VarChar(128)
  decisionRole String?     @map("decision_role") @db.VarChar(64)
  mobile       String?     @db.VarChar(32)
  phone        String?     @db.VarChar(32)
  email        String?     @db.VarChar(128)
  status       String      @default("ACTIVE") @db.VarChar(32)
  remark       String?     @db.VarChar(500)
  sortNo       Int         @default(0)
  version      Int         @default(1)
  createdBy    String      @map("created_by") @db.VarChar(128)
  updatedBy    String      @map("updated_by") @db.VarChar(128)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer     CrmCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([systemCode, customerId], map: "crm_contact_customer_idx")
  @@map("crm_customer_contact")
}

