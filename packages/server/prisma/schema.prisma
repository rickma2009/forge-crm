generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  DISABLED
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum MenuNodeType {
  GROUP
  PAGE
}

enum PageResourceType {
  SYSTEM
  MODULE
  PAGE
  SUBPAGE
  COMPONENT
}

enum ResourcePermissionMode {
  RESTRICTED
  COMMON
}

enum ResourceButtonType {
  TOOL
  LINE
}

enum RoleType {
  SYSTEM
  BUSINESS
}

enum PermissionType {
  MENU
  ACTION
}

enum UserType {
  INTERNAL
  EXTERNAL
  SERVICE
}

enum PermissionSource {
  SYSTEM
  CUSTOM
}

enum OrgUnitType {
  COMPANY
  DIVISION
  DEPARTMENT
  TEAM
}

enum ItemType {
  PRODUCT
  MATERIAL
  SEMI_FINISHED
}

enum InboundType {
  PRODUCTION
  FINISHED_GOODS
  TRANSFER
  STOCK_GAIN
}

enum InboundStatus {
  DRAFT
  POSTED
  REVERSED
  VOIDED
}

enum InventoryMoveType {
  INBOUND
  REVERSAL
}

model SysTenant {
  id           String           @id @default(uuid()) @db.Uuid
  tenantCode   String           @unique(map: "sys_tenant_tenant_code_key") @map("tenant_code") @db.VarChar(64)
  tenantName   String           @map("tenant_name") @db.VarChar(128)
  status       RecordStatus     @default(ACTIVE)
  version      Int              @default(1)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  applications SysApplication[]
  orgUnits     OrgUnit[]
  employees    OrgEmployee[]
  positions    OrgPosition[]

  @@map("sys_tenant")
}

model OrgUnit {
  id                  String                  @id @default(uuid()) @db.Uuid
  tenantId            String                  @map("tenant_id") @db.Uuid
  parentId            String?                 @map("parent_id") @db.Uuid
  unitCode            String                  @map("unit_code") @db.VarChar(64)
  unitName            String                  @map("unit_name") @db.VarChar(128)
  unitType            OrgUnitType             @map("unit_type")
  sortNo              Int                     @default(0) @map("sort_no")
  status              RecordStatus            @default(ACTIVE)
  effectiveAt         DateTime                @default(now()) @map("effective_at") @db.Timestamptz(3)
  expiresAt           DateTime?               @map("expires_at") @db.Timestamptz(3)
  remark              String?                 @db.VarChar(500)
  version             Int                     @default(1)
  createdBy           String                  @map("created_by") @db.Uuid
  updatedBy           String                  @map("updated_by") @db.Uuid
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant              SysTenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parent              OrgUnit?                @relation("OrgUnitTree", fields: [parentId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  children            OrgUnit[]               @relation("OrgUnitTree")
  userAssignments     OrgUserAssignment[]
  employeeAssignments OrgEmployeeAssignment[]
  roleBindings        SysRoleSubjectBinding[]

  @@unique([tenantId, unitCode], map: "org_unit_tenant_code_key")
  @@unique([id, tenantId], map: "org_unit_id_tenant_key")
  @@index([tenantId, parentId, sortNo], map: "org_unit_tree_idx")
  @@index([tenantId, status], map: "org_unit_status_idx")
  @@map("org_unit")
}

model SysApplication {
  id                     String                     @id @default(uuid()) @db.Uuid
  tenantId               String                     @map("tenant_id") @db.Uuid
  applicationCode        String                     @map("application_code") @db.VarChar(64)
  applicationName        String                     @map("application_name") @db.VarChar(128)
  status                 RecordStatus               @default(ACTIVE)
  version                Int                        @default(1)
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                 SysTenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roleGroups             SysRoleGroup[]
  permissions            SysPermission[]
  pageResources          SysPageResource[]
  authorizationResources SysAuthorizationResource[]
  parameters             SysParameter[]
  userGroups             SysUserGroup[]

  @@unique([tenantId, applicationCode], map: "sys_application_tenant_code_key")
  @@unique([id, tenantId], map: "sys_application_id_tenant_key")
  @@index([applicationCode, status], map: "sys_application_code_status_idx")
  @@map("sys_application")
}

model SysRoleGroup {
  id            String         @id @default(uuid()) @db.Uuid
  applicationId String         @map("application_id") @db.Uuid
  groupCode     String         @map("group_code") @db.VarChar(64)
  groupName     String         @map("group_name") @db.VarChar(128)
  sortNo        Int            @default(0) @map("sort_no")
  status        RecordStatus   @default(ACTIVE)
  version       Int            @default(1)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  application   SysApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([applicationId, groupCode], map: "sys_role_group_application_code_key")
  @@map("sys_role_group")
}

model SysPermission {
  id             String              @id @default(uuid()) @db.Uuid
  applicationId  String              @map("application_id") @db.Uuid
  permissionCode String              @map("permission_code") @db.VarChar(160)
  permissionName String              @map("permission_name") @db.VarChar(128)
  resourceCode   String              @map("resource_code") @db.VarChar(128)
  actionCode     String              @map("action_code") @db.VarChar(64)
  source         PermissionSource    @default(SYSTEM)
  status         RecordStatus        @default(ACTIVE)
  version        Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  application    SysApplication      @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grants         IamRolePermission[]

  @@unique([applicationId, permissionCode], map: "sys_permission_application_code_key")
  @@unique([id, applicationId], map: "sys_permission_id_application_key")
  @@index([applicationId, resourceCode, status], map: "sys_permission_lookup_idx")
  @@map("sys_permission")
}

model SysAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  applicationId  String   @map("application_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actionCode     String   @map("action_code") @db.VarChar(128)
  resourceType   String   @map("resource_type") @db.VarChar(64)
  resourceId     String?  @map("resource_id") @db.VarChar(128)
  beforeSnapshot Json?    @map("before_snapshot")
  afterSnapshot  Json?    @map("after_snapshot")
  requestId      String   @map("request_id") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([applicationId, createdAt(sort: Desc)], map: "sys_audit_log_application_time_idx")
  @@index([actorUserId, createdAt(sort: Desc)], map: "sys_audit_log_actor_time_idx")
  @@map("sys_audit_log")
}

model UiMenu {
  id                 String           @id @default(uuid()) @db.Uuid
  systemCode         String           @map("system_code") @db.VarChar(64)
  applicationId      String?          @map("application_id") @db.Uuid
  accessPermissionId String?          @map("access_permission_id") @db.Uuid
  pageResourceId     String?          @map("page_resource_id") @db.Uuid
  menuCode           String           @map("menu_code") @db.VarChar(64)
  menuName           String           @map("menu_name") @db.VarChar(128)
  nodeType           MenuNodeType     @map("node_type")
  parentId           String?          @map("parent_id") @db.Uuid
  routePath          String?          @map("route_path") @db.VarChar(256)
  iconKey            String           @map("icon_key") @db.VarChar(64)
  sortNo             Int              @default(0) @map("sort_no")
  menuType           String           @default("PAGE") @map("menu_type") @db.VarChar(20)
  openType           String           @default("INTERNAL") @map("open_type") @db.VarChar(20)
  autoAdd            Boolean          @default(true) @map("is_auto_add")
  remark             String?          @db.VarChar(500)
  status             RecordStatus     @default(ACTIVE)
  version            Int              @default(1)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  parent             UiMenu?          @relation("MenuTree", fields: [parentId, systemCode], references: [id, systemCode], onDelete: Restrict, onUpdate: Cascade)
  children           UiMenu[]         @relation("MenuTree")
  actions            UiMenuAction[]
  pageResource       SysPageResource? @relation(fields: [pageResourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([systemCode, menuCode], map: "ui_menu_system_code_menu_code_key")
  @@unique([id, systemCode], map: "ui_menu_id_system_code_key")
  @@index([systemCode, status, parentId, sortNo], map: "ui_menu_navigation_idx")
  @@index([pageResourceId], map: "sys_menu_page_resource_idx")
  @@map("sys_menu")
}

model SysPageResource {
  id                    String                 @id @default(uuid()) @db.Uuid
  tenantId              String                 @map("tenant_id") @db.Uuid
  applicationId         String                 @map("application_id") @db.Uuid
  pageCode              String                 @map("page_code") @db.VarChar(128)
  pageName              String                 @map("page_name") @db.VarChar(128)
  parentId              String?                @map("parent_id") @db.Uuid
  pageType              PageResourceType       @map("page_type")
  routePath             String?                @map("route_path") @db.VarChar(256)
  iconKey               String                 @map("icon_key") @db.VarChar(64)
  permissionMode        ResourcePermissionMode @default(RESTRICTED) @map("permission_mode")
  autoAddMenu           Boolean                @default(true) @map("is_auto_add_menu")
  viewConfigEnabled     Boolean                @default(false) @map("is_view_config_enabled")
  groupManageEnabled    Boolean                @default(false) @map("is_group_manage_enabled")
  dataPermissionEnabled Boolean                @default(false) @map("is_data_permission_enabled")
  sortNo                Int                    @default(0) @map("sort_no")
  status                RecordStatus           @default(ACTIVE)
  remark                String?                @db.VarChar(1000)
  version               Int                    @default(1)
  createdBy             String                 @map("created_by") @db.Uuid
  updatedBy             String                 @map("updated_by") @db.Uuid
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  application           SysApplication         @relation(fields: [applicationId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  parent                SysPageResource?       @relation("PageResourceTree", fields: [parentId, applicationId], references: [id, applicationId], onDelete: Restrict, onUpdate: Cascade)
  children              SysPageResource[]      @relation("PageResourceTree")
  buttons               SysPageButton[]
  ownedTabs             SysPageTab[]           @relation("PageTabs")
  targetTabs            SysPageTab[]           @relation("TabTarget")
  menuMounts            UiMenu[]

  @@unique([applicationId, pageCode], map: "sys_page_resource_application_code_key")
  @@unique([id, applicationId], map: "sys_page_resource_id_application_key")
  @@index([applicationId, parentId, status, sortNo], map: "sys_page_resource_tree_idx")
  @@map("sys_page_resource")
}

model SysPageButton {
  id         String             @id @default(uuid()) @db.Uuid
  pageId     String             @map("page_id") @db.Uuid
  buttonCode String             @map("button_code") @db.VarChar(128)
  buttonName String             @map("button_name") @db.VarChar(128)
  buttonType ResourceButtonType @map("button_type")
  iconKey    String?            @map("icon_key") @db.VarChar(64)
  eventName  String?            @map("event_name") @db.VarChar(128)
  sortNo     Int                @default(0) @map("sort_no")
  status     RecordStatus       @default(ACTIVE)
  remark     String?            @db.VarChar(1000)
  version    Int                @default(1)
  createdBy  String             @map("created_by") @db.Uuid
  updatedBy  String             @map("updated_by") @db.Uuid
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  page       SysPageResource    @relation(fields: [pageId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([pageId, buttonCode], map: "sys_page_button_page_code_key")
  @@index([pageId, status, sortNo], map: "sys_page_button_lookup_idx")
  @@map("sys_page_button")
}

model SysPageTab {
  id            String          @id @default(uuid()) @db.Uuid
  applicationId String          @map("application_id") @db.Uuid
  pageId        String          @map("page_id") @db.Uuid
  targetPageId  String          @map("target_page_id") @db.Uuid
  tabName       String          @map("tab_name") @db.VarChar(80)
  sortNo        Int             @default(0) @map("sort_no")
  status        RecordStatus    @default(ACTIVE)
  remark        String?         @db.VarChar(300)
  version       Int             @default(1)
  createdBy     String          @map("created_by") @db.Uuid
  updatedBy     String          @map("updated_by") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  page          SysPageResource @relation("PageTabs", fields: [pageId, applicationId], references: [id, applicationId], onDelete: Restrict, onUpdate: Cascade)
  targetPage    SysPageResource @relation("TabTarget", fields: [targetPageId, applicationId], references: [id, applicationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([pageId, tabName], map: "sys_page_tab_page_name_key")
  @@index([pageId, status, sortNo], map: "sys_page_tab_lookup_idx")
  @@index([targetPageId], map: "sys_page_tab_target_idx")
  @@map("sys_page_tab")
}

model UiMenuAction {
  id           String       @id @default(uuid()) @db.Uuid
  menuId       String       @map("menu_id") @db.Uuid
  permissionId String?      @map("permission_id") @db.Uuid
  actionCode   String       @map("action_code") @db.VarChar(64)
  actionName   String       @map("action_name") @db.VarChar(128)
  actionType   String       @map("action_type") @db.VarChar(64)
  sortNo       Int          @default(0) @map("sort_no")
  status       RecordStatus @default(ACTIVE)
  version      Int          @default(1)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  menu         UiMenu       @relation(fields: [menuId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([menuId, actionCode], map: "ui_menu_action_menu_id_action_code_key")
  @@unique([id, menuId], map: "ui_menu_action_id_menu_id_key")
  @@index([menuId, status, sortNo], map: "ui_menu_action_lookup_idx")
  @@map("sys_menu_action")
}

model IamUser {
  id                      String                     @id @default(uuid()) @db.Uuid
  tenantId                String?                    @map("tenant_id") @db.Uuid
  employeeId              String?                    @unique(map: "sys_user_employee_id_key") @map("employee_id") @db.Uuid
  account                 String                     @db.VarChar(128)
  normalizedAccount       String                     @map("normalized_account") @db.VarChar(128)
  displayName             String                     @map("display_name") @db.VarChar(128)
  userType                UserType                   @default(INTERNAL) @map("user_type")
  authSource              String                     @default("LOCAL") @map("auth_source") @db.VarChar(32)
  externalSubject         String?                    @map("external_subject") @db.VarChar(256)
  passwordHash            String?                    @map("password_hash") @db.VarChar(512)
  status                  UserStatus                 @default(ACTIVE)
  version                 Int                        @default(1)
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  roleMemberships         IamRoleUser[]
  organizationAssignments OrgUserAssignment[]
  employee                OrgEmployee?               @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  groupMemberships        SysUserGroupMember[]
  personalListViews       UiUserListView[]
  listViewPreferences     UiUserListViewPreference[]

  @@unique([tenantId, normalizedAccount], map: "sys_user_tenant_normalized_account_key")
  @@unique([id, tenantId], map: "sys_user_id_tenant_key")
  @@unique([employeeId, tenantId], map: "sys_user_employee_tenant_key")
  @@index([status], map: "iam_user_status_idx")
  @@map("sys_user")
}

model OrgEmployee {
  id           String                  @id @default(uuid()) @db.Uuid
  tenantId     String                  @map("tenant_id") @db.Uuid
  employeeName String                  @map("employee_name") @db.VarChar(128)
  email        String?                 @db.VarChar(256)
  mobile       String?                 @db.VarChar(32)
  status       RecordStatus            @default(ACTIVE)
  remark       String?                 @db.VarChar(500)
  version      Int                     @default(1)
  createdBy    String                  @map("created_by") @db.Uuid
  updatedBy    String                  @map("updated_by") @db.Uuid
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant       SysTenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  employments  OrgEmployment[]
  assignments  OrgEmployeeAssignment[]
  user         IamUser?

  @@unique([id, tenantId], map: "org_employee_id_tenant_key")
  @@index([tenantId, status, employeeName], map: "org_employee_lookup_idx")
  @@map("org_employee")
}

model OrgEmployment {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  employeeId     String       @map("employee_id") @db.Uuid
  employeeNo     String       @map("employee_no") @db.VarChar(64)
  employmentType String       @default("FULL_TIME") @map("employment_type") @db.VarChar(32)
  status         RecordStatus @default(ACTIVE)
  effectiveAt    DateTime     @default(now()) @map("effective_at") @db.Timestamptz(3)
  expiresAt      DateTime?    @map("expires_at") @db.Timestamptz(3)
  version        Int          @default(1)
  createdBy      String       @map("created_by") @db.Uuid
  updatedBy      String       @map("updated_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  employee       OrgEmployee  @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, employeeNo], map: "org_employment_tenant_employee_no_key")
  @@index([employeeId, status, effectiveAt, expiresAt], map: "org_employment_active_idx")
  @@map("org_employment")
}

model OrgPosition {
  id           String                  @id @default(uuid()) @db.Uuid
  tenantId     String                  @map("tenant_id") @db.Uuid
  positionCode String                  @map("position_code") @db.VarChar(64)
  positionName String                  @map("position_name") @db.VarChar(128)
  status       RecordStatus            @default(ACTIVE)
  version      Int                     @default(1)
  createdBy    String                  @map("created_by") @db.Uuid
  updatedBy    String                  @map("updated_by") @db.Uuid
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant       SysTenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignments  OrgEmployeeAssignment[]

  @@unique([tenantId, positionCode], map: "org_position_tenant_code_key")
  @@unique([id, tenantId], map: "org_position_id_tenant_key")
  @@index([tenantId, status, positionName], map: "org_position_lookup_idx")
  @@map("org_position")
}

model OrgEmployeeAssignment {
  id                   String       @id @default(uuid()) @db.Uuid
  tenantId             String       @map("tenant_id") @db.Uuid
  employeeId           String       @map("employee_id") @db.Uuid
  orgUnitId            String       @map("org_unit_id") @db.Uuid
  positionId           String       @map("position_id") @db.Uuid
  positionNameSnapshot String       @map("position_name_snapshot") @db.VarChar(128)
  assignmentType       String       @default("PRIMARY") @map("assignment_type") @db.VarChar(32)
  isPrimary            Boolean      @default(true) @map("is_primary")
  status               RecordStatus @default(ACTIVE)
  effectiveAt          DateTime     @default(now()) @map("effective_at") @db.Timestamptz(3)
  expiresAt            DateTime?    @map("expires_at") @db.Timestamptz(3)
  version              Int          @default(1)
  createdBy            String       @map("created_by") @db.Uuid
  updatedBy            String       @map("updated_by") @db.Uuid
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  employee             OrgEmployee  @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  organization         OrgUnit      @relation(fields: [orgUnitId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  position             OrgPosition  @relation(fields: [positionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([employeeId, orgUnitId, positionId, effectiveAt], map: "org_employee_assignment_period_key")
  @@index([employeeId, status, effectiveAt, expiresAt], map: "org_employee_assignment_active_idx")
  @@index([orgUnitId, status], map: "org_employee_assignment_org_idx")
  @@map("org_employee_assignment")
}

model IamRole {
  id                 String                  @id @default(uuid()) @db.Uuid
  systemCode         String                  @map("system_code") @db.VarChar(64)
  tenantId           String?                 @map("tenant_id") @db.Uuid
  applicationId      String?                 @map("application_id") @db.Uuid
  roleGroupId        String?                 @map("role_group_id") @db.Uuid
  parentId           String?                 @map("parent_id") @db.Uuid
  roleCode           String                  @map("role_code") @db.VarChar(64)
  roleName           String                  @map("role_name") @db.VarChar(128)
  roleAbbrName       String?                 @map("role_abbr_name") @db.VarChar(64)
  roleType           RoleType                @map("role_type")
  isSystem           Boolean                 @default(false) @map("is_system")
  isEnabled          Boolean                 @default(true) @map("is_enabled")
  archivedAt         DateTime?               @map("archived_at") @db.Timestamptz(3)
  sortNo             Int                     @default(0) @map("sort_no")
  effectiveDateBegin DateTime?               @map("effective_date_begin") @db.Timestamptz(3)
  effectiveDateEnd   DateTime?               @map("effective_date_end") @db.Timestamptz(3)
  description        String?                 @db.VarChar(512)
  status             RecordStatus            @default(ACTIVE)
  version            Int                     @default(1)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  members            IamRoleUser[]
  grants             IamRolePermission[]
  listViews          IamRoleListView[]
  dataPolicies       SysRoleDataPolicy[]
  subjectBindings    SysRoleSubjectBinding[]
  parent             IamRole?                @relation("RoleTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children           IamRole[]               @relation("RoleTree")

  @@unique([systemCode, roleCode], map: "iam_role_system_code_role_code_key")
