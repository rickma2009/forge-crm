model SdQuotation {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  applicationId String            @map("application_id") @db.Uuid
  systemCode    String            @map("system_code") @db.VarChar(64)
  quoteCode     String            @unique @map("quote_code") @db.VarChar(64)
  title         String            @db.VarChar(200)
  customerId    String            @map("customer_id") @db.Uuid
  customerName  String            @map("customer_name") @db.VarChar(255)
  contactId     String?           @map("contact_id") @db.Uuid
  contactName   String?           @map("contact_name") @db.VarChar(100)
  opportunityId String?           @map("opportunity_id") @db.Uuid
  ownerUserId   String            @map("owner_user_id") @db.Uuid
  quoteDate     DateTime          @map("quote_date") @db.Date
  validUntil    DateTime          @map("valid_until") @db.Date
  status        String            @default("DRAFT") @db.VarChar(16)
  total         Decimal           @default(0) @db.Decimal(18, 2)
  terms         String            @default("") @db.VarChar(8000)
  remark        String            @default("") @db.VarChar(2000)
  sourceQuoteId String?           @map("source_quote_id") @db.Uuid
  version       Int               @default(1)
  createdBy     String            @map("created_by") @db.Uuid
  updatedBy     String            @map("updated_by") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  lines         SdQuotationLine[]
  events        SdQuoteEvent[]

  @@unique([id, tenantId, applicationId])
  @@index([applicationId, ownerUserId, updatedAt])
  @@index([opportunityId])
  @@index([customerId])
  @@index([status, validUntil])
  @@map("sd_quotation")
}

model SdQuotationLine {
  id             String      @id @default(uuid()) @db.Uuid
  quotationId    String      @map("quotation_id") @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  applicationId  String      @map("application_id") @db.Uuid
  productId      String      @map("product_id") @db.Uuid
  priceId        String?     @map("price_id") @db.Uuid
  productCode    String      @map("item_code") @db.VarChar(32)
  productName    String      @map("product_name") @db.VarChar(128)
  model          String?     @db.VarChar(128)
  unit           String      @db.VarChar(32)
  productLine    String      @map("product_line") @db.VarChar(64)
  quantity       Decimal     @db.Decimal(18, 4)
  suggestedPrice Decimal     @map("suggested_price") @db.Decimal(18, 2)
  priceSource    String      @map("price_source") @db.VarChar(16)
  lowerQty       Decimal?    @map("lower_qty") @db.Decimal(18, 4)
  upperQty       Decimal?    @map("upper_qty") @db.Decimal(18, 4)
  unitPrice      Decimal     @map("unit_price") @db.Decimal(18, 2)
  discount       Decimal     @default(1) @db.Decimal(5, 2)
  amount         Decimal     @db.Decimal(18, 2)
