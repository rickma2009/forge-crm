model ScmBom {
  id            String         @id @default(uuid()) @map("bom_id") @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  applicationId String         @map("application_id") @db.Uuid
  itemId        String         @map("item_id") @db.Uuid
  bomCode       String         @map("bom_code") @db.VarChar(32)
  revision      Int
  status        String         @default("DRAFT") @db.VarChar(16)
  isCurrent     Boolean        @default(false) @map("is_current")
  baseQuantity  Decimal        @default(1) @map("base_quantity") @db.Decimal(18, 4)
  rowVersion    Int            @default(1) @map("row_version")
  createdBy     String         @map("created_by") @db.VarChar(128)
  updatedBy     String         @map("updated_by") @db.VarChar(128)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  lines         ScmBomLine[]   @relation("BomLines")
  referencedBy  ScmBomLine[]   @relation("ChildBom")
  application   SysApplication @relation(fields: [applicationId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction, map: "scm_bom_app_fk")
  item          MdItem         @relation(fields: [itemId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction, map: "scm_bom_item_fk")

  @@unique([applicationId, itemId, revision], map: "scm_bom_item_rev_key")
  @@unique([applicationId, bomCode, revision], map: "scm_bom_code_rev_key")
  @@unique([id, applicationId, tenantId], map: "scm_bom_scope_key")
  @@index([tenantId, applicationId, status, updatedAt], map: "scm_bom_list_idx")
  @@map("scm_bom")
}

model ScmBomLine {
  id            String              @id @default(uuid()) @map("line_id") @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  applicationId String              @map("application_id") @db.Uuid
  bomId         String              @map("bom_id") @db.Uuid
  lineCode      String              @map("line_code") @db.VarChar(32)
  itemId        String              @map("item_id") @db.Uuid
  quantity      Decimal             @db.Decimal(18, 4)
  sortNo        Int                 @default(10) @map("sort_no")
  childBomId    String?             @map("child_bom_id") @db.Uuid
  bom           ScmBom              @relation("BomLines", fields: [bomId, applicationId, tenantId], references: [id, applicationId, tenantId], onDelete: Cascade, onUpdate: NoAction, map: "scm_bom_line_bom_fk")
  childBom      ScmBom?             @relation("ChildBom", fields: [childBomId, applicationId, tenantId], references: [id, applicationId, tenantId], onDelete: Restrict, onUpdate: NoAction, map: "scm_bom_line_child_fk")
  item          MdItem              @relation(fields: [itemId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction, map: "scm_bom_line_item_fk")
  alternatives  ScmBomAlternative[]

  @@unique([bomId, lineCode], map: "scm_bom_line_code_key")
  @@unique([id, applicationId, tenantId], map: "scm_bom_line_scope_key")
  @@index([applicationId, itemId], map: "scm_bom_line_item_idx")
  @@map("scm_bom_line")
}

model ScmBomAlternative {
  id            String     @id @default(uuid()) @map("alternative_id") @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  applicationId String     @map("application_id") @db.Uuid
  lineId        String     @map("line_id") @db.Uuid
  itemId        String     @map("item_id") @db.Uuid
  priority      Int        @default(1)
  ratio         Decimal    @default(1) @db.Decimal(18, 4)
  line          ScmBomLine @relation(fields: [lineId, applicationId, tenantId], references: [id, applicationId, tenantId], onDelete: Cascade, onUpdate: NoAction, map: "scm_bom_alt_line_fk")
  item          MdItem     @relation(fields: [itemId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction, map: "scm_bom_alt_item_fk")

  @@unique([lineId, itemId], map: "scm_bom_alt_item_key")
  @@unique([lineId, priority], map: "scm_bom_alt_priority_key")
  @@index([applicationId, itemId], map: "scm_bom_alt_lookup_idx")
  @@map("scm_bom_alternative")
}

