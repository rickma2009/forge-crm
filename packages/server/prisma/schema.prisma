  tenantId            String    @map("tenant_id") @db.Uuid
  applicationId       String    @unique(map: "int_de_market_config_app_key") @map("application_id") @db.Uuid
  enabled             Boolean   @default(false)
  scheduleTime        String    @default("09:00") @map("schedule_time") @db.VarChar(5)
  timezone            String    @default("Asia/Shanghai") @db.VarChar(64)
  commodityApiBaseUrl String    @default("https://api.commoditypriceapi.com/v3") @map("commodity_api_base_url") @db.VarChar(500)
  fxApiBaseUrl        String    @default("https://api.frankfurter.dev/v2/rates") @map("fx_api_base_url") @db.VarChar(500)
  credentialCipher    String?   @map("credential_cipher") @db.Text
  lastRunAt           DateTime? @map("last_run_at") @db.Timestamptz(3)
  lastSuccessAt       DateTime? @map("last_success_at") @db.Timestamptz(3)
  lastScheduledDate   DateTime? @map("last_scheduled_date") @db.Date
  lastError           String?   @map("last_error") @db.VarChar(1000)
  isRunning           Boolean   @default(false) @map("is_running")
  version             Int       @default(1)
  createdBy           String    @map("created_by") @db.Uuid
  updatedBy           String    @map("updated_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([id, tenantId, applicationId], map: "int_de_market_config_scope_key")
  @@map("int_de_market_config")
}

model IntDeMarketItem {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  applicationId  String    @map("application_id") @db.Uuid
  itemCode       String    @map("item_code") @db.VarChar(32)
  itemName       String    @map("item_name") @db.VarChar(80)
  sourceSymbol   String    @map("source_symbol") @db.VarChar(64)
  benchmark      String    @db.VarChar(120)
  unit           String    @db.VarChar(80)
  enabled        Boolean   @default(true)
  lastMarketDate DateTime? @map("last_market_date") @db.Date
  lastFetchedAt  DateTime? @map("last_fetched_at") @db.Timestamptz(3)
  version        Int       @default(1)
  createdBy      String    @map("created_by") @db.Uuid
  updatedBy      String    @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([applicationId, itemCode], map: "int_de_market_item_app_code_key")
  @@unique([id, tenantId, applicationId], map: "int_de_market_item_scope_key")
  @@index([applicationId, enabled, itemCode], map: "int_de_market_item_list_idx")
  @@map("int_de_market_item")
}

model IntDeMarketFx {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  sourceCode    String   @default("FRANKFURTER") @map("source_code") @db.VarChar(32)
  baseCurrency  String   @default("USD") @map("base_currency") @db.VarChar(3)
  quoteCurrency String   @default("CNY") @map("quote_currency") @db.VarChar(3)
  effectiveDate DateTime @map("effective_date") @db.Date
  rate          Decimal  @db.Decimal(18, 8)
  fetchedAt     DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)

  @@unique([applicationId, sourceCode, baseCurrency, quoteCurrency, effectiveDate], map: "int_de_market_fx_day_key")
  @@unique([id, tenantId, applicationId], map: "int_de_market_fx_scope_key")
  @@index([applicationId, effectiveDate], map: "int_de_market_fx_date_idx")
  @@map("int_de_market_fx")
}

model IntDeMarketPrice {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  itemId        String   @map("item_id") @db.Uuid
  fxId          String   @map("fx_id") @db.Uuid
  sourceCode    String   @default("COMMODITY_PRICE_API") @map("source_code") @db.VarChar(32)
  marketDate    DateTime @map("market_date") @db.Date
  sourceSymbol  String   @map("source_symbol") @db.VarChar(64)
  benchmark     String   @db.VarChar(120)
  unit          String   @db.VarChar(80)
  openUsd       Decimal? @map("open_usd") @db.Decimal(20, 8)
  highUsd       Decimal? @map("high_usd") @db.Decimal(20, 8)
  lowUsd        Decimal? @map("low_usd") @db.Decimal(20, 8)
  closeUsd      Decimal  @map("close_usd") @db.Decimal(20, 8)
  openCny       Decimal? @map("open_cny") @db.Decimal(20, 8)
  highCny       Decimal? @map("high_cny") @db.Decimal(20, 8)
  lowCny        Decimal? @map("low_cny") @db.Decimal(20, 8)
  closeCny      Decimal  @map("close_cny") @db.Decimal(20, 8)
  fxRate        Decimal  @map("fx_rate") @db.Decimal(18, 8)
  fxDate        DateTime @map("fx_date") @db.Date
  fetchedAt     DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)
  sourcePayload Json     @map("source_payload")

  @@unique([applicationId, itemId, sourceCode, marketDate], map: "int_de_market_price_day_key")
  @@unique([id, tenantId, applicationId], map: "int_de_market_price_scope_key")
  @@index([applicationId, itemId, marketDate], map: "int_de_market_price_trend_idx")
  @@map("int_de_market_price")
}

model IntDeMarketCursor {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  applicationId String    @map("application_id") @db.Uuid
  cursorCode    String    @map("cursor_code") @db.VarChar(40)
  cursorDate    DateTime? @map("cursor_date") @db.Date
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([applicationId, cursorCode], map: "int_de_market_cursor_app_code_key")
  @@map("int_de_market_cursor")
}

model IntDeMarketRun {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  applicationId String    @map("application_id") @db.Uuid
  triggerType   String    @map("trigger_type") @db.VarChar(16)
  status        String    @db.VarChar(16)
  startDate     DateTime  @map("start_date") @db.Date
  endDate       DateTime  @map("end_date") @db.Date
  itemCount     Int       @default(0) @map("item_count")
  successCount  Int       @default(0) @map("success_count")
  failureCount  Int       @default(0) @map("failure_count")
