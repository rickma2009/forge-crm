  @@unique([documentId, revision], map: "sys_agent_know_revision_key")
  @@index([applicationId, ownerUserId, documentId], map: "sys_agent_know_owner_idx")
  @@map("sys_agent_knowledge")
}

/// Isolated demonstration records and future read-only API configuration; never authoritative business facts.
model SysDeSceneWorkspace {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  scenarioCode String @map("scenario_code") @db.VarChar(32)
