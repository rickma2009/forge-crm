{
  "name": "@interaction-pattern-lab/server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @interaction-pattern-lab/contracts build && prisma generate",
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @interaction-pattern-lab/contracts build && prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" prisma.config.ts",
    "pretypecheck": "pnpm --filter @interaction-pattern-lab/contracts build && prisma generate",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "pretest": "pnpm --filter @interaction-pattern-lab/contracts build && prisma generate",
    "test": "jest --runInBand",
    "test:performance": "tsx scripts/performance-navigation.ts",
    "prisma:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "predb:seed": "prisma generate",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@interaction-pattern-lab/contracts": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/adapter-pg": "~7.9.0",
    "@prisma/client": "~7.9.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@interaction-pattern-lab/tsconfig": "workspace:*",
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "prisma": "~7.9.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.2.0",
    "ts-loader": "^9.5.0",
    "tsx": "^4.20.0",
    "typescript": "5.7.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.ts$": "ts-jest" },
    "setupFiles": ["<rootDir>/test/setup-env.ts"],
    "testEnvironment": "node"
  }
}
